# Allowlisting gitignore template for GO projects prevents us
# from adding various unwanted local files, such as generated
# files, developer configurations or IDE-specific files etc.
#
# Recommended: Go.AllowList.gitignore

# Ignore everything
*

# But not these files...
!/.gitignore
!/.gitattributes
!/.dockerignore

!*.go
!go.sum
!go.mod
!handlers/scraper/dictionary.bin

!README.md
!docs/*.md
!TESTING.md
!CONTRIBUTING.md
!SECURITY.md
!.env.example
!LICENSE
!Dockerfile
!auth-helper/*.py
!auth-helper/Dockerfile
!auth-helper/requirements.txt
!Caddyfile
!docker-compose.example.yml
!.github/assets/*.jpg
!scripts/*.yml
!scripts/*.yaml
!scripts/*.py
!BingSiteAuth.xml
!examples/cloudflare-worker/
!examples/cloudflare-worker/README.md
!examples/cloudflare-worker/src/
!examples/cloudflare-worker/src/*.js
!examples/cloudflare-worker/*.jsonc

# Keep the two public test/demo assets required by the current Dockerfile.
/video/instagram7-reel/**
!/video/instagram7-reel/out/
!/video/instagram7-reel/out/instagram7-test-reel.mp4
!/video/instagram7-reel/out/instagram7-test-reel-poster.webp

# Never track local/session secrets.
secrets/
**/secrets/
*cookie*
!handlers/admin_cookies.go
!handlers/admin_cookies_test.go
*.env
!.env.example

# !Makefile

# ...even if they are in subdirectories
!*/

# Local agent/plugin installations.
.agents/
